<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.4.xsd">

    <changeSet author="ARVATO" id="1.00.000_createTableRole">
        <createTable tableName="role">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PKRole"/>
            </column>
            <column name="name" type="NVARCHAR(255)">
                <constraints nullable="false" unique="true" />
            </column>
            <column name="description" type="NVARCHAR(1000)">
                <constraints nullable="true"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet author="ARVATO" id="1.00.000_insertRoleData">
        <insert tableName="role">
            <column name="name" value="Analyst"/>
            <column name="description" value="Bla"/>

        </insert>
    </changeSet>
</databaseChangeLog>
