<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.4.xsd">

    <changeSet author="ARVATO" id="1.00.000_createTableSite">
        <createTable tableName="site">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PKSite"/>
            </column>
            <column name="name" type="NVARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="NVARCHAR(1023)">
                <constraints nullable="true"/>
            </column>
            <column name="url" type="NVARCHAR(1023)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="NVARCHAR(20)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet author="ARVATO" id="1.00.000_insertSiteData">
        <insert tableName="site">
            <column name="name" value="arvato"/>
            <column name="description" value="arvato main site"/>
            <column name="url" value="https://atlcloud.arvato.de"/>
            <column name="status" value="ACTIVE"/>
        </insert>
    </changeSet>
</databaseChangeLog>
